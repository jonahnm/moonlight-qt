--- a/util/timer.cpp
+++ b/util/timer.cpp
@@ -145,8 +145,15 @@ void sleep_until_nsecs(int64_t timepoint)
 	ts.tv_nsec = timepoint % 1000000000ll;
 	// Linux does not support clock_nanosleep with MONOTONIC_RAW :(
 	int ret;
+#ifdef __APPLE__
+	// macOS does not expose TIMER_ABSTIME for clock_nanosleep(); the absolute
